PORT=5000
MONGO_URI=
JWT_SECRET=

# Public URL of this backend (used to build payment URLs and the gateway callback URL)
BASE_URL=http://localhost:5000

# Paytm
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
# Staging: https://securegw-stage.paytm.in   Production: https://securegw.paytm.in
PAYTM_HOST=https://securegw-stage.paytm.in

# CORS — comma-separated browser origins
ADMIN_ORIGINS=http://localhost:3000
WEB_ORIGINS=http://localhost:5173

# Encrypts bank account / PAN / GST at rest. REQUIRED in production: use a long random
# string and never change it afterwards (existing data could no longer be decrypted).
DATA_ENCRYPTION_KEY=

# Email (verification codes, approval notices). Without SMTP_HOST, emails are printed to the
# server console in development and registration is refused in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Paytrixx <no-reply@yourdomain.com>

# First admin created by `npm run seed:admin`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
